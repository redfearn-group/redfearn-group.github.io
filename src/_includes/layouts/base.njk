<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} &middot; Redfearn Group{% else %}{{ site.title }} &middot; {{ site.tagline }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">

  <link rel="icon" type="image/svg+xml" href="/assets/rg-mark.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png">
  <link rel="icon" href="/assets/favicon.ico" sizes="any">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#BF1E2E">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;1,300&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <!-- brand.css must load first: it defines the tokens main.css consumes.
       Vendored from redfearn-group/redfearn-brand, CI fails on drift. -->
  <link rel="stylesheet" href="/css/brand.css">
  <link rel="stylesheet" href="/css/main.css">
  {% if extraCss %}<link rel="stylesheet" href="/css/{{ extraCss }}.css">{% endif %}

  <link rel="alternate" type="application/rss+xml" title="Redfearn Group Insights" href="/insights/feed.xml">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Redfearn Group">
  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/og-cards/{{ ogSlug or 'home' }}.png">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title or site.title }}">
  <meta name="twitter:description" content="{{ description or site.description }}">
  <meta name="twitter:image" content="{{ site.url }}/og-cards/{{ ogSlug or 'home' }}.png">

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}",
    "jobTitle": "AI Product Leader",
    "description": "{{ site.description }}",
    "affiliation": {
      "@type": "Organization",
      "name": "Redfearn Group",
      "url": "{{ site.url }}"
    },
    "homeLocation": {
      "@type": "Place",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Spanish Fork",
        "addressRegion": "UT",
        "addressCountry": "US"
      }
    },
    "alumniOf": [
      {
        "@type": "CollegeOrUniversity",
        "name": "Virginia Tech",
        "url": "https://www.vt.edu/"
      },
      {
        "@type": "CollegeOrUniversity",
        "name": "Brigham Young University",
        "url": "https://www.byu.edu/"
      }
    ],
    "hasCredential": [
      {
        "@type": "EducationalOccupationalCredential",
        "credentialCategory": "degree",
        "educationalLevel": "Doctorate",
        "name": "PhD, Industrial and Systems Engineering",
        "recognizedBy": { "@type": "CollegeOrUniversity", "name": "Virginia Tech" }
      },
      {
        "@type": "EducationalOccupationalCredential",
        "credentialCategory": "degree",
        "educationalLevel": "Master's Degree",
        "name": "MS, User Experience Research",
        "recognizedBy": { "@type": "CollegeOrUniversity", "name": "Brigham Young University" }
      }
    ],
    "sameAs": [
      "{{ site.linkedin }}",
      "{{ site.github }}",
      "{{ site.scholar }}",
      "{{ site.researchgate }}",
      "{{ site.x }}"
    ],
    "knowsAbout": ["Artificial Intelligence", "AI Product Management", "Large Language Models", "LLM Agents", "Agentic AI", "AI Governance", "Responsible AI", "Generative AI", "Prompt Engineering", "AI Platform Architecture", "Product Strategy", "Enterprise Software", "Systems Engineering", "UX Research", "Human-Computer Interaction", "Usability Testing", "Cybersecurity", "Technical Writing"]
  }
  </script>
</head>
<body class="{{ bodyClass or '' }}">
  <a class="skip-link" href="#main">Skip to content</a>
  {% include "partials/nav.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
</body>
</html>
