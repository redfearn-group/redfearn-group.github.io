<thead><tr><th><strong>Taxing entity</strong></th><th><strong>Rate</strong></th><th><strong>Share of the levy</strong></th><th><strong>Year one, $4B at the 2026 rate</strong> <a class="fnref" href="#fd0"><sup>43</sup></a></th></tr></thead><tbody>
<tr><td><strong>Nebo School District</strong></td><td>0.007190</td><td>75.2% <a class="fnref" href="#fs18"><sup>15</sup></a></td><td>~$28.8M</td></tr>
<tr><td><strong>Utah County, local and state assessing, water</strong></td><td>0.001415</td><td>14.8% <a class="fnref" href="#fs18"><sup>15</sup></a></td><td>~$5.7M</td></tr>
<tr><td><strong>Spanish Fork City</strong></td><td>0.000958</td><td>10.0% <a class="fnref" href="#fs18"><sup>15</sup></a></td><td>~$3.8M</td></tr>
