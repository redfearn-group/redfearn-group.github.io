   var y=window.scrollY+90,best=null;
   for(var i=0;i<heads.length;i++){
     var t=heads[i].getBoundingClientRect().top+window.scrollY;
     if(t<=y)best=heads[i];else break;}
   var de=document.documentElement,bd=document.body,
       h=Math.max(de.scrollHeight,de.offsetHeight,bd?bd.scrollHeight:0,bd?bd.offsetHeight:0)
         -window.innerHeight;
   prog.style.width=(h>0?Math.min(100,Math.max(0,window.scrollY/h*100)):0)+'%';
   if(!best||best===cur)return;
   cur=best;
   var id=best.id,lbl=best.tagName==='SECTION'
       ?(best.querySelector('h2')||{}).textContent:best.textContent;
   here.textContent=(lbl||'').trim();
   for(var j=0;j<links.length;j++)
     links[j].classList.toggle('on',links[j].getAttribute('href')==='#'+id);
 }
 function later(){requestAnimationFrame(function(){requestAnimationFrame(spy);});}
 addEventListener('scroll',spy,{passive:true});
 addEventListener('resize',spy);
 addEventListener('hashchange',later);
 pan.addEventListener('click',later);
 spy();
})();
</script>

